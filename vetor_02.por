programa {
  funcao inicio() {
    cadeia vetor[3]
    escreva("Digite sua primeira comida favorita: \n")
    leia(vetor[0])
    escreva("Digite sua segunda comida favorita: \n")
    leia(vetor[1])
    escreva("Digite sua terceira comida favorita: \n")
    leia(vetor[2])

    escreva("A comida salva foi a ", vetor[1])
  }
}
