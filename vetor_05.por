programa {
  funcao inicio () {
    cadeia vetor[3]
    escreva("Digite uma cor: ")
    leia(vetor[0])
    escreva("Digite uma segunda cor: ")
    leia(vetor[1])
    escreva("Digite uma terceira cor: ")
    leia(vetor[2])

    escreva("--- Cores digitadas ---\n")
    escreva(vetor[2], "\n")
    escreva(vetor[1], "\n")
    escreva(vetor[0], "\n")
  }
}