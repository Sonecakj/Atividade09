programa {
  funcao inicio() {
    inteiro matriz[2][2], linha, coluna

    para(linha = 0; linha <2; linha++){
      para(coluna = 0; coluna <2; coluna++){
        leia(matriz[linha][coluna])
      }
    }
    para(linha = 0; linha <2; linha++){
      para(coluna = 0; coluna <2; coluna++){
        escreva(matriz[linha][coluna], " ")
  }
  escreva("\n")
}
 }
  }
